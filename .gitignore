# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Logs
*.log

# 本地-only 材料（不进入远程仓库）
docs/
prototype/
.playwright-mcp/
.claude/
/*.png
/*.jpg

# Node / 前端
node_modules/
client/frontend/dist/
# Web 客户端构建产物（#50，base=/ 独立目录，桌面构建的 dist/ 不受影响）
client/frontend/dist-web/

# Go / Wails 构建产物
client/build/bin/
# 第三方许可证随附目录（build/third-party-licenses.sh 的产物，打包时现生成）
client/build/third-party/
# go-task（wails3 task）的 sources/generates 校验缓存
.task/
dist/
*.exe

# 服务端默认数据目录（SQLite、证书缓存、自动生成的 jwt.secret）
/data/
/server/data/

# Web 客户端产物（#50）：占位 .gitkeep 必须进仓库（go:embed 的前提），
# 真实产物由 CI 在 package-server 编译前解到该目录，不进 git。
# 例外必须写在上面 dist/ 规则之后（父目录先放行，子文件才可能被放行）。
!server/internal/webui/dist/
!server/internal/webui/dist/.gitkeep
