# 轻音 LiteTalk — 自动更新器环境变量示例（#97）
# 部署位置：/etc/litetalk-updater.env（chmod 600 root:root）
# systemd 在启动前以 root 读取本文件并注入进程环境；secret 本体不在这里，
# 放独立文件（见 LITETALK_UPDATER_SECRET_FILE），本文件不进仓库、不打印 secret。
# 优先级：命令行 flag > 环境变量 > 默认值。

# ---- 总开关 / 通道 ----
# 1=正常自动更新。0 时 webhook 只校验签名与格式并返回 202 ignored，
# 不下载、不替换、不重启（排障/维护窗口用）；update.sh --once 手工升级不受影响。
# LITETALK_UPDATER_ENABLED=1
# 0=只接受正式版 tag（默认）；1 才接受 -alpha/-beta/-rc 预发布。
# 被通道策略拒绝的 delivery 同样返回 202 ignored，不执行更新。
# LITETALK_UPDATER_ALLOW_PRERELEASE=0

# ---- 监听 / TLS（TLS-ALPN-01，不依赖 80）----
# LITETALK_UPDATER_LISTEN=:443            # 默认 :443
# LITETALK_UPDATER_DOMAIN=update.openalc.cc  # 签发域名；DNS A 记录指向本机
# LITETALK_UPDATER_TLS_CACHE=/var/lib/litetalk-updater/autocert  # 证书缓存（0700）
# LITETALK_UPDATER_NO_TLS=0               # 1=明文 HTTP（仅本地/测试）

# ---- webhook 校验 ----
# secret 文件（0640 root:<服务用户>，如 root:www）。内容为 GitHub webhook 的 secret（openssl rand -hex 32），
# 与 GitHub 侧 webhook 配置保持一致；文件缺失/为空时更新器拒绝启动（fail-closed）。
# 权限必须让服务用户可读（0600 root:root 会 EACCES），但 other 位必须为 0。
# LITETALK_UPDATER_SECRET_FILE=/etc/litetalk-updater.webhook.secret
# 仓库白名单：只接受该仓库的 release 事件
# LITETALK_UPDATER_REPO=OpenALC/LiteTalk

# ---- 更新目标 ----
# LITETALK_UPDATER_INSTALL_DIR=/www/wwwroot/LiteTalk   # 主服务安装目录
# LITETALK_UPDATER_SERVICE=litetalk.service            # 重启目标（sudoers 同名）
# LITETALK_UPDATER_HEALTH_URL=http://127.0.0.1:8077/api/v1/healthz
# LITETALK_UPDATER_HEALTH_TIMEOUT=60s                  # 更新后版本断言超时，失败自动回滚
# LITETALK_UPDATER_STATE_DIR=/var/lib/litetalk-updater # 状态/去重记录目录
# LITETALK_UPDATER_ASSET=                             # 资产名覆盖（默认 litetalk-server-linux-<arch>.tar.gz）
