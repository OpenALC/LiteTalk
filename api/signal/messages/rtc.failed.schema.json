{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litetalk:signal:rtc.failed",
  "title": "RTCFailedData",
  "x-wire-type": "rtc.failed",
  "x-go-const": "TypeRTCFailed",
  "x-direction": "S2C",
  "x-since": 1,
  "description": "SFU 因 ICE 失败移除本端 PeerConnection。只发给该 peer 的连接；客户端收到后销毁本地 PC 并重新入房，其余成员走 channel.peer_left。",
  "type": "object",
  "properties": {
    "channel_id": { "type": "string" },
    "reason": {
      "type": "string",
      "description": "固定 ice_failed"
    }
  },
  "required": ["channel_id", "reason"],
  "additionalProperties": false
}
