{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litetalk:signal:channel.joined",
  "title": "ChannelJoinedData",
  "x-wire-type": "channel.joined",
  "x-go-const": "TypeChannelJoined",
  "x-direction": "S2C",
  "x-since": 1,
  "x-namespace": "voice",
  "description": "房间成员全量。成员变化时向房间内每个成员重发全量（Self 为接收者本人的快照）。",
  "type": "object",
  "properties": {
    "channel_id": { "type": "string" },
    "members": {
      "type": "array",
      "items": { "$ref": "components.schema.json#/$defs/MemberInfo" }
    },
    "self": { "$ref": "components.schema.json#/$defs/MemberInfo" },
    "audio_bitrate_kbps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128,
      "x-since": 2,
      "x-go-omitempty": true,
      "x-go-pointer": true,
      "description": "语音频道码率上限 kbps（#46，协议 v2）；0 = 跟随客户端用户设置。旧服务端/开发内置房间缺省。"
    },
    "audio_frame_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "x-since": 2,
      "x-go-omitempty": true,
      "x-go-pointer": true,
      "description": "语音频道 Opus 帧长毫秒（#46，协议 v2）；0 = 默认 20ms。旧服务端/开发内置房间缺省。"
    }
  },
  "required": ["channel_id", "members", "self"],
  "additionalProperties": false
}
