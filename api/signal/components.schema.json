{
  "$comment": "信令共享类型（#29）。被 messages/ 下的消息 schema 以 $ref 引用；生成两侧 protocol_gen.go 时按类型名去重。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litetalk:signal:components",
  "$defs": {
    "UserBrief": {
      "title": "UserBrief",
      "description": "用户简要信息。M2 中 id 即用户名。",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nickname": { "type": "string" }
      },
      "required": ["id", "nickname"],
      "additionalProperties": false
    },
    "MemberInfo": {
      "title": "MemberInfo",
      "description": "房间成员快照（含语音状态，供晚加入者拿到当前状态）。",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "nickname": { "type": "string" },
        "tag": {
          "type": "string",
          "x-go-omitempty": true,
          "description": "昵称#tag 的 tag，好友请求用"
        },
        "mute": { "type": "boolean" },
        "deafen": { "type": "boolean" },
        "speaking": { "type": "boolean" },
        "online": {
          "type": "boolean",
          "description": "在线态（presence:{uid} 存在即在线），与 REST 成员视图同源"
        },
        "priority": {
          "type": "boolean",
          "x-since": 3,
          "x-go-omitempty": true,
          "description": "优先发言（PrioritySpeaker，#45，协议 v3）：owner/Administrator 经 effective() 自动为 true；角色/成员角色变更在下次 channel.joined 刷新。缺省 false。"
        }
      },
      "required": ["user_id", "nickname", "mute", "deafen", "speaking", "online"],
      "additionalProperties": false
    },
    "SDPData": {
      "title": "SDPData",
      "description": "rtc.offer / rtc.answer 的载荷。",
      "type": "object",
      "properties": {
        "sdp": { "type": "string" }
      },
      "required": ["sdp"],
      "additionalProperties": false
    },
    "ReplyPreview": {
      "title": "ReplyPreview",
      "description": "回复消息的预览快照（#39）：只含跳转与展示所需字段；被引用消息已软删时 content 为空、deleted=true。",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "nickname": { "type": "string" },
        "content": { "type": "string" },
        "deleted": { "type": "boolean" }
      },
      "required": ["id", "user_id", "nickname", "content", "deleted"],
      "additionalProperties": false
    },
    "AttachmentInfo": {
      "title": "AttachmentInfo",
      "description": "消息附件元数据（#41）。url/thumbnail_url 是带能力 key 的相对路径（/api/v1/attachments/{id}?key=...），客户端自行拼服务端基址；不需要 Authorization。",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "filename": { "type": "string" },
        "size": { "type": "integer" },
        "content_type": { "type": "string" },
        "width": {
          "type": "integer",
          "description": "原图像素宽；非图片为 0"
        },
        "height": {
          "type": "integer",
          "description": "原图像素高；非图片为 0"
        },
        "url": { "type": "string" },
        "thumbnail_url": {
          "type": "string",
          "x-go-omitempty": true,
          "description": "带能力 key 的缩略图相对路径；非图片或未生成缩略图时缺省"
        }
      },
      "required": ["id", "filename", "size", "content_type", "url"],
      "additionalProperties": false
    }
  }
}
