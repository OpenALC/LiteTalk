# 统一行尾为 LF。本机 core.autocrlf=true，检出时会把文本转成 CRLF，
# 导致 gofmt -l 长期列出全部 .go 文件（本地永远无法满足「gofmt -l 无输出」门禁），
# 且 Go 工具改写文件后在 git status 里制造假改动。
# eol=lf 优先于 core.autocrlf，对所有克隆（含 agent worktree）生效。

# Go 与 shell
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.sh    text eol=lf

# 配置与数据库迁移
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.txt   text eol=lf

# 容器构建（#27）：CRLF 会打断 Dockerfile 的反斜杠续行
Dockerfile     text eol=lf
.dockerignore  text eol=lf

# 前端（Vue/TS 源码与工程配置）
*.ts    text eol=lf
*.tsx   text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# 文档、桌面集成与部署配置（#27 收尾补）。这些类型此前未覆盖，只靠本机
# core.autocrlf=true 兜底——开源贡献者若用 autocrlf=false 会直接提交 CRLF。
# .desktop 尤其要注意：Exec 行若带 \r，桌面环境启动会失败。
*.md       text eol=lf
*.desktop  text eol=lf
*.conf     text eol=lf
*.service  text eol=lf
*.example  text eol=lf
.env       text eol=lf
.gitattributes text eol=lf

# 第三方 vendored 代码不设规则：行尾随上游，不为统一格式制造无意义 diff
# （client/third_party/** 保持原样）
